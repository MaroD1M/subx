# ============================================================
# SubX v2.6.2 环境变量示例
# ============================================================
# 说明：
# - 本文件是“完整参考”，不是全部都需要设置。
# - Docker Compose 会读取同目录 .env；也可以直接在 compose 中写死。
# - 带 [可选] / 注释的变量按需开启；默认值以镜像内为准。
# ============================================================

# ---------------- 基础 ----------------

# [必填] 视频挂载目录。Docker 部署通常映射为 /media 或 /data。
# 本地开发建议使用相对路径或绝对路径。
VIDEO_DIR=./videos

# [可选] SQLite 数据库路径（未设置 DATABASE_URL 时使用）。
# Docker 中推荐 /app/db/subx.db；本地开发可用 ./db/subx.db。
DB_PATH=./demo_db/subx.db

# [可选] 容器时区，影响日志和任务时间显示。
TZ=Asia/Shanghai

# [可选] 容器运行用户。建议与媒体文件所有者一致。
# 查看 NAS 上媒体所有者：ls -ln /path/to/your/media
PUID=1001
PGID=1001

# [可选] 启动时递归修复媒体目录权限。大媒体库会比较慢，建议只临时开启。
CHOWN_MEDIA=false

# [可选] 启动时递归修复 /models 权限。从旧 sidecar 切换或目录属主异常时开启。
CHOWN_MODELS=false

# [可选] 跳过降权，直接以 root 运行。仅用于极端排障，不推荐。
# RUN_AS_ROOT=false

# [推荐] API Key 加密主密钥。
# 生成方式：openssl rand -hex 32
# 注意：更换后旧 API Key 需要重新填写。
# SUBX_SECRET_KEY=change-me-to-a-long-random-secret

# [可选] 仅当服务位于可信反向代理之后时启用。
# TRUST_PROXY=true

# [可选] 额外允许的跨域来源，逗号分隔。
# SUBX_ALLOWED_ORIGINS=https://subx.example.com

# [可选] 自定义 FFmpeg / FFprobe 路径；容器内通常不需要设置。
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# [可选] 通知出站 / 模型下载默认代理（标准环境变量）。
# 容器里的 127.0.0.1 指向容器自己；代理在宿主机时请写局域网 IP。
# HTTP_PROXY=http://192.168.1.10:7890
# HTTPS_PROXY=http://192.168.1.10:7890
# ALL_PROXY=http://192.168.1.10:7890
# NO_PROXY=localhost,127.0.0.1

# ---------------- 单镜像内置 ASR / OCR ----------------

# 单镜像标记：主应用默认连接容器内 127.0.0.1:8000 / 8001。
# Docker 单镜像通常写 true；本地拆分开发可设为 false。
# SUBX_ALL_IN_ONE=true

# [可选] 保留旧的 subx-asr / subx-ocr 外部 sidecar 地址，不做自动迁移。
# SUBX_KEEP_LEGACY_SIDECAR_URLS=true

# [可选] 内置服务监听端口（只绑定 127.0.0.1，不对外暴露）。
# 修改端口后，启动脚本会自动生成对应内部 URL。
ASR_INTERNAL_PORT=8000
OCR_INTERNAL_PORT=8001

# [可选] 显式覆盖主应用默认连接的内置服务地址；一般不需要。
# ASR_INTERNAL_URL=http://127.0.0.1:8000
# OCR_INTERNAL_URL=http://127.0.0.1:8001

# [可选] 内置服务鉴权。仅本机回环，通常不需要。
# 设置后需在「设置 → 语音识别」填写相同 Key。
# ASR_API_KEY=
# OCR_API_KEY=

# ---------------- 内置 ASR ----------------

# [可选] ASR 模型缓存目录；需与 compose 的 /models 卷对应。
# 本地开发可改成 ./data/models/asr 之类的本地路径。
ASR_MODEL_DIR=/models
ASR_WHISPER_CPP_MODEL_DIR=/models/whisper-cpp

# [可选] 是否允许首次识别时静默下载模型。
# 单镜像建议 false，统一在设置页手动下载并查看进度。
ASR_AUTO_DOWNLOAD=false

# [可选] 模型下载默认代理，仅支持 http:// / https://。
# 未设置时会读取容器标准 HTTP_PROXY / HTTPS_PROXY / NO_PROXY。
# ASR_DOWNLOAD_PROXY=http://127.0.0.1:7890

# [可选] Hugging Face 镜像站，例如国内网络可设为 https://hf-mirror.com。
# ASR_HF_ENDPOINT=https://hf-mirror.com

# [可选] 提取音频缓存天数；任务失败/重试会优先复用缓存。
# 默认 14 天，最小 7 天。缓存位于 /app/temp/asr-audio。
# ASR_AUDIO_CACHE_DAYS=14

# [可选] 默认 ASR 模型；设置页可覆盖。
ASR_MODEL=small

# [可选] 运行设备：auto / cpu / cuda。
# 单镜像为 CPU 版，cuda 仅适用于 asr-gpu sidecar。
ASR_DEVICE=auto

# [可选] 计算精度：int8 / float16 / float32。CPU 推荐 int8，GPU 推荐 float16。
ASR_COMPUTE_TYPE=int8

# [可选] 识别引擎：auto / faster-whisper / whisper-cpp / cloud。
ASR_ENGINE=auto

# [可选] 音频预处理：off / demucs / deepfilternet。
# Demucs / DeepFilterNet 需要 asr-enhanced sidecar；单镜像会回退原始音频。
ASR_PREPROCESS=off

# [可选] 设置页可下载的模型列表，逗号分隔。
ASR_AVAILABLE_MODELS=tiny,base,small,medium,large-v3,large-v3-turbo

# [可选] whisper.cpp 可选模型列表；一般与 ASR_AVAILABLE_MODELS 一致。
# ASR_WHISPER_CPP_MODELS=tiny,base,small,medium,large-v3,large-v3-turbo

# [可选] whisper.cpp 推理线程数；0 表示使用 CPU 核心数。
# ASR_THREADS=0

# [可选] 说话人分离模型；仅 asr-enhanced sidecar 有效。
# ASR_DIARIZATION_MODEL=pyannote/speaker-diarization-3.1

# [可选] Hugging Face Token；仅 asr-enhanced 的说话人分离/受许可模型需要。
# HF_TOKEN=hf_xxx

# ---------------- 内置 OCR ----------------

# [可选] OCR 可访问的媒体根目录，必须与 /media 卷一致。
OCR_MEDIA_ROOT=/media

# [可选] 默认 OCR 语言，例如 en / zh-CN / ja。
OCR_LANGUAGE=en

# [可选] OCR 引擎：auto / rapidocr / tesseract。
OCR_ENGINE=auto

# [可选] 抽帧 OCR 帧率；低配 NAS 可降到 1。
OCR_FPS=2

# [可选] 抽帧 OCR 并行线程数；低配可降到 2。
OCR_WORKERS=4

# [可选] 低置信度过滤阈值（0–100），低于该值的结果会被丢弃。
OCR_MIN_CONFIDENCE=25

# [可选] 单个视频最大 OCR 时长（秒），超过直接报错。
OCR_MAX_SECONDS=7200

# [可选] 主应用轮询 OCR 任务状态的间隔（毫秒）。高级参数，一般不需要改。
# OCR_POLL_MS=1500

# ---------------- 数据库 / 多 Worker ----------------

# [可选] PostgreSQL 运行时。设置后优先使用 PostgreSQL，DB_PATH 不再生效。
# DATABASE_URL=postgres://subx:subx@postgres:5432/subx
# [可选] PostgreSQL 连接池大小；同步桥为低并发设计。
# PG_POOL_SIZE=5

# [可选] PostgreSQL 容器参数；需与 DATABASE_URL 保持一致。
# POSTGRES_USER=subx
# POSTGRES_PASSWORD=subx
# POSTGRES_DB=subx

# [可选] 单主机多 Worker / 多实例标识；默认使用进程 PID。
# SUBX_WORKER_ID=worker-1
# [可选] 回收陈旧任务的超时时间（秒）。
# SUBX_WORKER_STALE_SECONDS=120

# ---------------- 拆分部署 sidecar ----------------
#
# 单镜像已经内置 ASR/OCR，一般不需要下面这些 profile：
#   docker compose --profile asr up -d asr
#   docker compose --profile ocr up -d ocr
#   docker compose --profile asr-gpu up -d asr-gpu
#   docker compose --profile asr-enhanced up -d asr-enhanced
#   docker compose --profile postgres up -d postgres
#
# 独立 ASR 容器：设置页 ASR 地址改为 http://subx-asr:8000。
# 独立 OCR 容器：设置页 OCR 地址改为 http://subx-ocr:8000。
# 独立 GPU ASR：设置页 ASR 地址改为 http://subx-asr-gpu:8000。
# 增强 ASR：设置页 ASR 地址改为 http://subx-asr-enhanced:8000。
#
# sidecar 模型目录默认是 ./data/models/asr，和单镜像的 ./data/models 不同。
# 从单镜像迁移到拆分部署时，请确认模型目录或重新下载。
