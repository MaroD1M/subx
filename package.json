{
  "name": "subx",
  "version": "2.9.2",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:pg": "vitest run server/utils/__tests__/pgLive.test.ts",
    "test:ocr": "python3 -m unittest discover -s ocr-service/tests -v",
    "preview:images": "playwright test --config playwright.preview.config.ts",
    "check:versions": "node scripts/check-versions.mjs",
    "test:api": "vitest run --config vitest.api.config.ts",
    "backup": "node scripts/backup-sqlite.mjs",
    "restore": "node scripts/restore-sqlite.mjs"
  },
  "dependencies": {
    "@nuxt/ui": "^4.12.0",
    "ass-compiler": "^0.1.x",
    "better-sqlite3": "^11.x",
    "chardet": "2.2.0",
    "chokidar": "^4.0.3",
    "fluent-ffmpeg": "^2.1.3",
    "iconv-lite": "0.7.3",
    "js-sha256": "^0.11.1",
    "nodemailer": "^10.3.1",
    "nuxt": "^4.6.4",
    "openai": "^7.52.0",
    "p-limit": "^7.3.3",
    "pg": "^8.23.1",
    "pino": "^8.x",
    "srt-parser-2": "^1.2.3",
    "undici": "^8.12.4",
    "uuid": "^14.x",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^9.39.5",
    "@iconify-json/lucide": "^1.2.151",
    "@nuxt/test-utils": "^4.4.0",
    "@playwright/test": "1.65.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.12.0",
    "@types/nodemailer": "^8.0.2",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "eslint": "10.14.0",
    "happy-dom": "^21.0.4",
    "pg-mem": "^3.0.14",
    "prettier": "3.9.10",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MaroD1M/subx.git"
  },
  "homepage": "https://github.com/MaroD1M/subx#readme",
  "bugs": {
    "url": "https://github.com/MaroD1M/subx/issues"
  },
  "overrides": {
    "minimatch": "^11.0.5",
    "glob": "^14.0.4",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
