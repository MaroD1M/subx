{
  "name": "subx",
  "version": "2.6.2",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:pg": "vitest run server/utils/__tests__/pgLive.test.ts"
  },
  "dependencies": {
    "@nuxt/ui": "^4.12.0",
    "ass-compiler": "^0.1.x",
    "better-sqlite3": "^11.x",
    "chardet": "2.2.0",
    "chokidar": "^4.0.3",
    "fluent-ffmpeg": "^2.1.3",
    "iconv-lite": "0.7.3",
    "js-sha256": "^0.11.1",
    "nodemailer": "^10.3.1",
    "nuxt": "^4.6.3",
    "openai": "^7.47.0",
    "p-limit": "^5.0.0",
    "pg": "^8.23.1",
    "pino": "^8.x",
    "srt-parser-2": "^1.2.3",
    "undici": "^7.30.1",
    "uuid": "^11.x",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^9.39.5",
    "@iconify-json/lucide": "^1.2.95",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.12.0",
    "@types/nodemailer": "^8.0.2",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "9.39.5",
    "pg-mem": "^3.0.14",
    "prettier": "3.9.10",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.2.9"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  },
  "repository": {
    "type": "git",
